# Copy to .env and adjust if needed.
# Local dev matches docker-compose.yml's postgres service.
DATABASE_URL="postgresql://varagov:varagov@localhost:5432/varagov"
# Production compose only: set this to a long random value on the VPS.
VARAGOV_DB_PASSWORD="varagov"

# Optional server-only CoinGecko Demo key for VARA/USD quotes.
# COINGECKO_DEMO_API_KEY=""
# Override the per-origin spend caps after verifying the exact deployed runtime version.
# Caps are whole VARA strings. The bundled table applies to Vara specVersion 20101.
# VARA_TREASURY_LIMITS='{"specVersion":0,"limits":{"small_tipper":"1000","big_tipper":"5000","small_spender":"500000","medium_spender":"10000000","big_spender":"50000000","treasurer":"100000000"}}'
# Publish the confirmed infrastructure estimate and multisig once the team supplies them.
# VARA_TREASURY_INFRASTRUCTURE='{"usd":18000,"due":"2027-08-31"}'
# VARA_TREASURY_MULTISIG='{"address":"<SS58>","threshold":3,"signers":["<SS58>","<SS58>","<SS58>","<SS58>"]}'
